    ["LC: Spiral Matrix"]="https://leetcode.com/problems/spiral-matrix/"
    ["LC: Set Matrix Zeroes"]="https://leetcode.com/problems/set-matrix-zeroes/"
    ["LC: Single Number II"]="https://leetcode.com/problems/single-number-ii/"
    ["LC: Number of 1 Bits"]="https://leetcode.com/problems/number-of-1-bits/"
    ["LC: Counting Bits"]="https://leetcode.com/problems/counting-bits/"
    ["LC: Reverse Bits"]="https://leetcode.com/problems/reverse-bits/"
)

keys=("${!QUESTIONS[@]}")

if [ ! -f "$STATE_FILE" ] || [ "$(head -n 1 "$STATE_FILE")" != "$TODAY" ]; then
    selected_indices=($(shuf -i 0-$((${#keys[@]} - 1)) -n 5))
    echo "$TODAY" > "$STATE_FILE"
    for idx in "${selected_indices[@]}"; do
        echo "${keys[$idx]}|${QUESTIONS[${keys[$idx]}]}" >> "$STATE_FILE"
    done
fi

mapfile -t lines < <(tail -n 5 "$STATE_FILE")

tooltip=""
urls=()
first=true
for line in "${lines[@]}"; do
    q_name="${line%%|*}"
    q_url="${line##*|}"
    if [ "$first" = true ]; then
        tooltip="• $q_name"
        first=false
    else
        tooltip+="\n• $q_name"
    fi
    urls+=("$q_url")
done

printf "%s\n" "${urls[@]}" > "$URLS_FILE"

printf '{"text": "    DSA", "alt": "dsa", "tooltip": "%s"}\n' "$tooltip"
