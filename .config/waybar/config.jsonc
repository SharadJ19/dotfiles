// -*- mode: jsonc -*-
{
  "layer": "top",
  "position": "top",
  "height": 32,
  "spacing": 2,

  "modules-left": ["sway/workspaces", "sway/mode", "sway/scratchpad", "custom/media"],
  "modules-center": [],
  "modules-right": [
    // "idle_inhibitor",
    "pulseaudio",
    // "network",
    "cpu",
    "memory",
    "backlight",
    "battery",
    "custom/dsa",
    "clock",
    "tray",
    "custom/power",
  ],
  "sway/mode": {
    "format": "<span style=\"italic\">{}</span>",
  },
  "sway/scratchpad": {
    "format": "{icon} {count}",
    "show-empty": false,
    "format-icons": ["", " "],
    "tooltip": true,
    "tooltip-format": "{app}: {title}",
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": "",
    },
  },
  "tray": {
    "spacing": 10,
    "show-passive-items": false,
  },
  "clock": {
    "format": "󰥔  {:%I:%M %p}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format-alt": "󰃭  {:%Y-%m-%d}",
  },
  "cpu": {
    "format": "  {usage}%",
    "tooltip": true,
  },
  "memory": {
    "format": "  {percentage}%",
  },
  "backlight": {
    "format": "{icon}  {percent}%",
    "format-icons": ["󰃞", "󰃟", "󰃠"],
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15,
    },
    "format": "{icon}  {capacity}%",
    "format-full": "{icon}  {capacity}%",
    "format-charging": "󰂄  {capacity}%",
    "format-plugged": "  {capacity}%",
    "format-alt": "{icon}  {time}",
    "format-icons": ["󰂎", "󰁺", "󰁼", "󰁽", "󰁿", "󰂁", "󰁹"],
  },
  "custom/dsa": {
    "exec": "~/.config/waybar/scripts/dsa_goal",
    "return-type": "json",
    "interval": 3600,
    "on-click": "~/.config/waybar/scripts/dsa_click",
    "tooltip": true,
  },
  "network": {
    "format-wifi": "    {essid} ({signalStrength}%)",
    "format-ethernet": "󰈀  {ipaddr}",
    "tooltip-format": "{ifname} via {gwaddr}",
    "format-linked": "󰈀  No IP",
    "format-disconnected": "⚠  Offline",
    "format-alt": "{ifname}: {ipaddr}/{cidr}",
  },
  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-bluetooth": "{icon}  {volume}%",
    "format-muted": "󰝟  Muted",
    "format-icons": {
      "headset": " ",
      "default": [" ", " ", " "],
    },
    "on-click": "pavucontrol",
  },
  "custom/media": {
    "format": "{icon}  {text}",
    "return-type": "json",
    "max-length": 35,
    "format-icons": {
      "default": " ",
    },
    "escape": true,
    "exec": "playerctl --player=spotify metadata --format '{\"text\": \"{{artist}} - {{title}}\", \"alt\": \"{{status}}\", \"class\": \"{{status}}\"}' --follow 2>/dev/null",
    "exec-if": "pgrep -x spotify",
    "on-click": "playerctl --player=spotify play-pause",
    "on-scroll-up": "playerctl --player=spotify next",
    "on-scroll-down": "playerctl --player=spotify previous",
  },
  "custom/power": {
    "format": "⏻",
    "tooltip": false,
    "on-click": "~/.config/rofi/scripts/powermenu",
  },
}
